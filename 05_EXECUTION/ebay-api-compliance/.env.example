# Deno Production: configure these with `deno deploy env add --secret`.
EBAY_VERIFICATION_TOKEN_SECRET=generate-32-to-80-alphanumeric-underscore-hyphen-characters
EBAY_PURGE_API_TOKEN_SECRET=generate-a-long-random-secret

# Local fallback names; do not configure these in Deno Production.
EBAY_VERIFICATION_TOKEN=
EBAY_PURGE_API_TOKEN=
EBAY_ENDPOINT_URL=https://your-app.your-org.deno.net/
DENO_DEPLOY_TOKEN=store-the-revocable-deno-cli-token-locally

# Bootstrap only. Set true immediately after Production credentials are available.
EBAY_REQUIRE_SIGNATURE=false

# Required when EBAY_REQUIRE_SIGNATURE=true.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# Local development only; Deno Deploy supplies its own port.
PORT=8787
EBAY_KV_PATH=:memory:
