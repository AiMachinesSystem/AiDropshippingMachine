    "mode": "draft",
    "listing": {
      "sku": "", "title": "", "description": "", "category": "",
      "source_url": "", "supplier": "", "cost": null, "sale_price": null,
      "shipping_policy": "", "return_policy": "", "handling_time": null,
      "quantity": null, "images": [], "condition": "", "marketplace": "eBay.com", "currency": "USD"
    }
  },
  "credentials_note": "Real AutoDS key lives ONLY in the n8n credential 'autods_api' (encrypted vault) or local .env. Never in this file."
