{
  "tasks": {
    "check": "deno fmt --check *.ts && deno lint *.ts && deno test --allow-read --allow-env *_test.ts && deno check cli.ts",
    "cli": "deno run --allow-net=api.ebay.com,auth.ebay.com --allow-read=manifests,action-packs,audit,.env.local,.oauth-state.local,.oauth-redirect.local --allow-write=.env.local,.oauth-state.local,.oauth-redirect.local,action-packs,audit --allow-env cli.ts"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.14"
  }
}
