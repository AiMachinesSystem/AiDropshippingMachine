{
  "name": "Ads Library Weekly Snapshot (NON CONNESSO - esempio, import disattivato)",
  "active": false,
  "nodes": [
    {
      "id": "trigger",
      "name": "Ogni lunedi 08:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0],
      "parameters": { "rule": { "interval": [{ "field": "cronExpression", "expression": "0 8 * * 1" }] } }
    },
    {
      "id": "fetch",
      "name": "Fetch Ad Library via proxy r.jina.ai (pubblico, no credenziali)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [220, 0],
      "parameters": {
        "url": "https://r.jina.ai/https://www.facebook.com/ads/library/?active_status=active&ad_type=all&country=ALL&q=<NICHE_KEYWORD_URLENCODED>&search_type=keyword_unordered",
        "options": { "timeout": 60000, "retry": { "maxTries": 3 } }
      }
    },
    {
      "id": "save",
      "name": "Salva raw in 90_CACHE (audit trail)",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1,
      "position": [440, 0],
      "parameters": {
        "operation": "write",
        "fileName": "<VAULT_ROOT>/90_CACHE/fetches/facebook.com/{{ $now.format('yyyy-MM-dd') }}_adslib_<NICHE_SLUG>.txt"
      }
    }
  ],
  "connections": {
    "Ogni lunedi 08:00": { "main": [[{ "node": "Fetch Ad Library via proxy r.jina.ai (pubblico, no credenziali)", "type": "main", "index": 0 }]] },
    "Fetch Ad Library via proxy r.jina.ai (pubblico, no credenziali)": { "main": [[{ "node": "Salva raw in 90_CACHE (audit trail)", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" },
  "meta": { "note": "Solo lettura web pubblica + scrittura file locale. Conteggi = lower bound (proxy rende ~10-28 blocchi). L'analisi resta a Claude/skill ads-library-scan." }
}
